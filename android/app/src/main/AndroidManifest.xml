<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Pairing QR only, and asked for only when the scanner is opened. The app is
      fully usable without it: the NSD list and a typed address are the other two
      ways in (§6), so a camera the user never grants costs nothing.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <!--
      Composer dictation only. Asked at the mic button, never at startup — the
      app is fully usable without it, and the IME's own mic is not a substitute
      for this lifecycle (frozen base, partials, teardown).
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <!--
      Android 13+ NSD / Wi-Fi peer discovery. neverForLocation: we only browse
      for _openmausbot._tcp, never derive physical location from the scan.
      Without this (and the multicast permission), NsdManager returns an empty
      list silently — the same footgun as missing NSLocalNetworkUsageDescription
      on iOS (briefing §19).
    -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        android:minSdkVersion="33" />
    <!--
      Android 17 (API 37): runtime local-network permission. Without the
      declaration and a grant, NSD browse and plain LAN sockets to the
      companion are blocked the same way iOS blocks Bonjour without
      NSLocalNetworkUsageDescription.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_LOCAL_NETWORK"
        android:minSdkVersion="37" />

    <!--
      Package visibility (API 30+): without this, SpeechRecognizer cannot see
      RecognitionService providers and isRecognitionAvailable() can falsely
      report none — dictation would never start on modern devices.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".OpenMausApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenMausMobile">

        <!--
          persistNever: nothing about this Activity, its launching Intent
          included, may be written to task state that survives a reboot. It only
          ever receives ACTION_MAIN or the sanitized Intent PairingLinkActivity
          builds, but a one-time pairing credential is not the kind of thing to
          protect by one layer.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:persistableMode="persistNever"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The deep-link door. A pairing URL carries a one-time credential, and the
          system keeps a copy of an Activity's launching Intent — handing it back
          on restart, and under the default persistRootOnly writing a root
          Activity's Intent across a reboot. This one is therefore never the root
          of the main task (its own taskAffinity), never kept in history, never in
          recents, and never persisted. It moves the invite into process memory
          and starts MainActivity with an Intent carrying no data and no extras.
        -->
        <activity
            android:name=".PairingLinkActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:persistableMode="persistNever"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="pair"
                    android:scheme="openmausbot" />
            </intent-filter>
        </activity>
        <!--
          The 25-second linger anchor (iOS buys the same window with
          beginBackgroundTask). An ordinary started service: no intent filter,
          no binder, no foreground service permission, no foregroundServiceType,
          and nothing to export — its only caller is this process, and its only
          effect is keeping this process out of the cached class while the
          window is open. stopWithTask: swiping the task away is the user
          saying they are done, so the window goes with it.
        -->
        <service
            android:name=".lifecycle.SessionLingerService"
            android:exported="false"
            android:stopWithTask="true" />

        <!--
          Share sheet hand-off for exported transcripts. Not exported, no
          granted URI permissions by default: each share grants read access to
          one file for one Intent, and only for the receiving app.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.transcripts"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
